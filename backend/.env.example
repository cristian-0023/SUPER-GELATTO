# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
# La llave pública NO sirve en producción (la base la rechaza); solo es respaldo en desarrollo.
SUPABASE_KEY=your_supabase_anon_key_here
# Obligatoria en producción (Vercel, Render o NODE_ENV=production): sin ella el servidor no arranca.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Llave de Tripo 3D. Sin ella el servidor arranca igual, pero no genera modelos 3D (esas rutas responden 503).
TRIPO_API_KEY=

# Email Configuration (SMTP). En producción, sin SMTP_HOST/SMTP_USER/SMTP_PASS "Olvidé mi contraseña" responde 503.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# JWT Authentication (obligatorio en producción, mínimo 32 caracteres; el servidor no arranca sin él)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google Sign-In: el MISMO client id que VITE_GOOGLE_CLIENT_ID del frontend (sin él, /api/google-login responde 503)
GOOGLE_CLIENT_ID=

# Administradores (correos en minúsculas, separados por comas). Al entrar con Google verificado salen como admin.
ADMIN_EMAILS=
# Cuenta principal protegida (la única que puede eliminar o bajar de rol a otros admins)
SUPER_ADMIN_EMAIL=

# Dirección pública del frontend (sin "/" al final). Los enlaces de "Olvidé mi contraseña" apuntan aquí.
# Obligatoria en producción: sin ella /api/forgot-password responde 503 (nunca enlaces a localhost).
FRONTEND_URL=http://localhost:3000

# WebAuthn / Passkeys (Biometría Face ID / Touch ID / Windows Hello)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Recuperación de contraseña: límite por CORREO (además del límite por IP). Valores por defecto entre paréntesis.
# Espera mínima entre dos enlaces para el mismo correo, en milisegundos (120000 = 2 minutos; 0 = sin espera)
RECUPERACION_ESPERA_MS=120000
# Máximo de enlaces por correo en 24 horas (5)
RECUPERACION_MAX_DIA=5

# Despertador diario (Vercel Cron): si la defines, /api/health exige "Authorization: Bearer <valor>" (Vercel lo manda solo).
# Sin ella la ruta es pública (no expone nada).
CRON_SECRET=
